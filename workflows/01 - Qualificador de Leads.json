        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": {{ JSON.stringify($json.openai_model) }},\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": {{ JSON.stringify($json.prompt_sistema) }}\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Nicho: ' + $json.negocio_nicho + '\\nNegócio: ' + $json.negocio_nome + '\\nLead: ' + $json.lead_nome + '\\nE-mail: ' + $json.lead_email + '\\nTelefone: ' + $json.lead_telefone + '\\nEmpresa: ' + $json.lead_empresa + '\\nOrigem: ' + $json.lead_origem + '\\nInteresse: ' + $json.lead_interesse + '\\nMensagem: ' + $json.lead_mensagem) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "e549b9af-c4fd-4760-804f-bd275151c7a3",
      "name": "HTTP — AI Agent classifica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1264,
        128
      ],
      "notes": "Classifica quente / morno / frio. Troque openai_api_key e modelo no Edit Fields."
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Edit Fields — Variáveis do Fluxo').item.json;\nconst ai = $input.first().json;\n\nlet raw = '';\ntry {\n  raw = ai.choices?.[0]?.message?.content\n    || ai.output\n    || ai.message\n    || (typeof ai === 'string' ? ai : JSON.stringify(ai));\n} catch (e) {\n  raw = '';\n}\n\nraw = String(raw).trim();\n// remove ```json fences se a IA mandar\nraw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/,'');\n\nlet parsed = {\n  classificacao: 'morno',\n  score: 50,\n  motivo: 'Fallback: não foi possível parsear a IA',\n  proxima_acao: 'Revisar lead manualmente'\n};\n\ntry {\n  const obj = JSON.parse(raw);\n  const c = String(obj.classificacao || obj.classification || 'morno').toLowerCase();\n  parsed.classificacao = ['quente', 'morno', 'frio'].includes(c) ? c : 'morno';\n  parsed.score = Number(obj.score ?? 50);\n  parsed.motivo = String(obj.motivo || obj.reason || '');\n  parsed.proxima_acao = String(obj.proxima_acao || obj.next_action || '');\n} catch (e) {\n  const lower = raw.toLowerCase();\n  if (lower.includes('quente') || lower.includes('hot')) parsed.classificacao = 'quente';\n  else if (lower.includes('frio') || lower.includes('cold')) parsed.classificacao = 'frio';\n  parsed.motivo = 'Parse parcial do texto da IA';\n}\n\nreturn [{\n  json: {\n    ...prev,\n    classificacao: parsed.classificacao,\n    score: parsed.score,\n    motivo_classificacao: parsed.motivo,\n    proxima_acao: parsed.proxima_acao,\n    ai_raw: raw\n  }\n}];"
      },
      "id": "44c62fbf-6efb-4c0e-8611-209380f31932",
      "name": "Code — Parse classificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        128
      ]
    },
