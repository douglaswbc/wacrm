      "id": "c1926f93-5165-433d-8492-9c156cc0b16a",
      "name": "HTTP — CRM/Sheets métricas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        16
      ],
      "notes": "Retorne JSON com métricas. Se não tiver API ainda, use o fallback do Code node."
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Edit Fields — Variáveis do Fluxo').first().json;\nconst raw = $input.first().json || {};\n\n// Normaliza métricas comuns do playbook (placeholders se API vazia)\nconst m = raw.metrics || raw.data || raw;\nconst metricas = {\n  leads_entrantes: Number(m.leads_entrantes ?? m.leads ?? 0),\n  leads_quentes: Number(m.leads_quentes ?? 0),\n  leads_mornos: Number(m.leads_mornos ?? 0),\n  leads_frios: Number(m.leads_frios ?? 0),\n  followups_enviados: Number(m.followups_enviados ?? m.followups ?? 0),\n  respostas: Number(m.respostas ?? 0),\n  agendamentos: Number(m.agendamentos ?? m.consultas ?? 0),\n  confirmados: Number(m.confirmados ?? 0),\n  faltas: Number(m.faltas ?? 0),\n  faltas_percentual: Number(m.faltas_percentual ?? 0),\n  emails_triagem: Number(m.emails_triagem ?? 0),\n  receita_estimada: Number(m.receita_estimada ?? m.receita ?? 0),\n  ticket_medio: Number(m.ticket_medio ?? 0),\n  observacoes: m.observacoes || m.notes || ''\n};\n\n// Fallback demo se tudo zero (útil para testar o fluxo)\nconst allZero = Object.entries(metricas)\n  .filter(([k]) => typeof metricas[k] === 'number')\n  .every(([, v]) => v === 0);\n\nif (allZero) {\n  metricas.leads_entrantes = 12;\n  metricas.leads_quentes = 3;\n  metricas.leads_mornos = 5;\n  metricas.leads_frios = 4;\n  metricas.followups_enviados = 6;\n  metricas.respostas = 2;\n  metricas.agendamentos = 8;\n  metricas.confirmados = 6;\n  metricas.faltas = 1;\n  metricas.faltas_percentual = 12.5;\n  metricas.emails_triagem = 15;\n  metricas.receita_estimada = 2400;\n  metricas.ticket_medio = 200;\n  metricas.observacoes = 'Dados de demonstração (API retornou vazio). Substitua crm_metrics_url.';\n  metricas._demo = true;\n}\n\nconst metricas_texto = Object.entries(metricas)\n  .map(([k, v]) => `${k}: ${v}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    ...cfg,\n    metricas,\n    metricas_texto,\n    metricas_json: JSON.stringify(metricas)\n  }\n}];"
      },
      "id": "ce4f7e72-c427-4b22-8c88-270883a1d6d4",
      "name": "Code — Normalizar métricas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.openai_api_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.openai_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": {{ JSON.stringify($json.openai_model) }},\n  \"temperature\": 0.4,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": {{ JSON.stringify($json.prompt_sistema) }} },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Cliente: ' + $json.cliente_nome + '\\nOperador: ' + $json.negocio_nome + '\\nPeríodo: ' + $json.periodo_label + '\\nMétricas:\\n' + $json.metricas_texto) }} }\n  ]\n}",
        "options": {}
      },
      "id": "fc7000dc-978e-4cec-8d34-ea24a6b4163a",
      "name": "HTTP — AI resumo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1664,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Code — Normalizar métricas').item.json;\nconst ai = $input.first().json;\nlet raw = ai.choices?.[0]?.message?.content || '';\nraw = String(raw).trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'');\n\nlet assunto = `Relatório semanal — ${prev.cliente_nome} (${prev.periodo_label})`;\nlet titulo = 'Relatório semanal de automações';\nlet resumo = 'Resumo indisponível.';\nlet destaques = [];\nlet alertas = [];\nlet proximos = [];\nlet corpo = '';\n\ntry {\n  const o = JSON.parse(raw);\n  assunto = o.assunto || assunto;\n  titulo = o.titulo || titulo;\n  resumo = o.resumo_executivo || o.resumo || resumo;\n  destaques = o.destaques || [];\n  alertas = o.alertas || [];\n  proximos = o.proximos_passos || o.proximos || [];\n  corpo = o.corpo_email || '';\n} catch (e) {\n  corpo = raw || resumo;\n}\n\nif (!corpo) {\n  const m = prev.metricas;\n  corpo =\n    `${titulo}\\n${prev.periodo_label}\\n\\n` +\n    `Olá,\\n\\n${resumo}\\n\\n` +\n    `Números da semana:\\n` +\n    `- Leads: ${m.leads_entrantes} (Q ${m.leads_quentes} / M ${m.leads_mornos} / F ${m.leads_frios})\\n` +\n    `- Follow-ups: ${m.followups_enviados} | Respostas: ${m.respostas}\\n` +\n    `- Agendamentos: ${m.agendamentos} | Confirmados: ${m.confirmados} | Faltas: ${m.faltas} (${m.faltas_percentual}%)\\n` +\n    `- Triagens de e-mail: ${m.emails_triagem}\\n` +\n    `- Receita estimada: R$ ${m.receita_estimada}\\n\\n` +\n    (destaques.length ? `Destaques:\\n- ${destaques.join('\\n- ')}\\n\\n` : '') +\n    (alertas.length ? `Alertas:\\n- ${alertas.join('\\n- ')}\\n\\n` : '') +\n    (proximos.length ? `Próximos passos:\\n- ${proximos.join('\\n- ')}\\n\\n` : '') +\n    `${prev.email_remetente_nome}\\n${prev.negocio_nome}`;\n}\n\nreturn [{\n  json: {\n    ...prev,\n    relatorio_assunto: assunto,\n    relatorio_titulo: titulo,\n    relatorio_resumo: resumo,\n    relatorio_destaques: Array.isArray(destaques) ? destaques.join(' | ') : String(destaques),\n    relatorio_alertas: Array.isArray(alertas) ? alertas.join(' | ') : String(alertas),\n    relatorio_proximos: Array.isArray(proximos) ? proximos.join(' | ') : String(proximos),\n    relatorio_corpo: corpo,\n    ai_raw: raw\n  }\n}];"
      },
