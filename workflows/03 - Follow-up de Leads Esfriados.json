{
  "name": "03 — Follow-up de Leads Esfriados",
  "nodes": [
    {
      "parameters": {
        "content": "## 03 — Follow-up de Leads Esfriados\n\n**Playbook:** Schedule → CRM leads >3 dias → Filter max 3 → AI e-mail personalizado → Send → CRM update\n\nConfigure **Edit Fields — Variáveis do Fluxo** e o endpoint do CRM.",
        "height": 320,
        "width": 340
      },
      "id": "note-03",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-420, 100]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "id": "sch-03",
      "name": "Schedule — Diário 10h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 260]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "f-negocio",
