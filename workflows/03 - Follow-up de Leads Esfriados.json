              "type": "string"
            },
            {
              "id": "r-status",
              "name": "status_apos_followup",
              "value": "={{ $json.status_apos_followup }}",
              "type": "string"
            },
            {
              "id": "r-crm",
              "name": "crm_update_url",
              "value": "={{ $json.crm_update_url }}",
              "type": "string"
            },
            {
              "id": "r-key",
              "name": "crm_api_key",
              "value": "={{ $json.crm_api_key }}",
              "type": "string"
            },
            {
              "id": "r-negocio",
              "name": "negocio_nome",
              "value": "={{ $json.negocio_nome }}",
              "type": "string"
            },
            {
              "id": "r-enviado",
              "name": "followup_enviado_em",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-out-03",
      "name": "Edit Fields — Pós-geração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1820, 180]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.email_remetente }}",
        "toEmail": "={{ $json.lead_email }}",
        "subject": "={{ $json.email_assunto }}",
        "emailType": "text",
        "message": "={{ $json.email_corpo }}",
        "options": {}
      },
      "id": "email-03",
      "name": "E-mail — Enviar follow-up",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2080, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.crm_update_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.crm_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": {{ JSON.stringify($json.lead_id) }},\n  \"status\": {{ JSON.stringify($json.status_apos_followup) }},\n  \"followup_enviado_em\": {{ JSON.stringify($json.followup_enviado_em) }},\n  \"assunto\": {{ JSON.stringify($json.email_assunto) }},\n  \"negocio\": {{ JSON.stringify($json.negocio_nome) }}\n}",
        "options": {}
      },
      "id": "http-upd-03",
      "name": "HTTP — CRM update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 180]
    }
  ],
