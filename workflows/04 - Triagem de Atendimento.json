      "id": "a8d6c8b0-f821-484c-be14-da590d7894bf",
      "name": "Edit Fields — Variáveis do Fluxo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        704,
        208
      ],
      "notes": "Mapeia e-mail IMAP + config de setores, IA e log."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.openai_api_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.openai_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": {{ JSON.stringify($json.openai_model) }},\n  \"temperature\": 0.2,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": {{ JSON.stringify($json.prompt_sistema) }} },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Negócio: ' + $json.negocio_nome + '\\nDe: ' + $json.mail_from + '\\nAssunto: ' + $json.mail_subject + '\\nCorpo:\\n' + $json.mail_text) }} }\n  ]\n}",
        "options": {}
      },
      "id": "23322fbe-6ce8-4f65-b599-545400cf473c",
      "name": "HTTP — AI classifica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        992,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Edit Fields — Variáveis do Fluxo').item.json;\nconst ai = $input.first().json;\nlet raw = ai.choices?.[0]?.message?.content || '';\nraw = String(raw).trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'');\nlet setor = 'outros';\nlet prioridade = 'media';\nlet resumo = 'Sem resumo';\nlet resposta = `Olá, recebemos sua mensagem em ${prev.negocio_nome}. Nossa equipe retornará em breve.`;\ntry {\n  const o = JSON.parse(raw);\n  setor = String(o.setor || 'outros').toLowerCase();\n  prioridade = String(o.prioridade || 'media').toLowerCase();\n  resumo = o.resumo || resumo;\n  resposta = o.resposta_cliente || resposta;\n} catch (e) {}\nconst mapa = {\n  financeiro: prev.email_setor_financeiro,\n  comercial: prev.email_setor_comercial,\n  suporte: prev.email_setor_suporte,\n  recepcao: prev.email_setor_recepcao,\n  outros: prev.email_setor_default\n};\nconst email_setor = mapa[setor] || prev.email_setor_default;\nreturn [{\n  json: {\n    ...prev,\n    setor,\n    prioridade,\n    resumo,\n    resposta_cliente: resposta,\n    email_setor_destino: email_setor,\n    ai_raw: raw\n  }\n}];"
      },
