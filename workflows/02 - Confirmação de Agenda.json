    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst expected = Buffer.from(`${j.event_id}:${j.token_secreto}`).toString('base64url');\nconst ok = j.token && j.token === expected && j.event_id;\nconst acao = String(j.acao || '').toLowerCase();\nconst valida = ok && (acao === 'confirma' || acao === 'remarca');\nreturn [{\n  json: {\n    ...j,\n    token_valido: !!ok,\n    resposta_valida: !!valida,\n    status_agenda: acao === 'confirma' ? j.status_confirmado : (acao === 'remarca' ? j.status_remarcar : 'invalido'),\n    prefixo_titulo: acao === 'confirma' ? '[OK] ' : (acao === 'remarca' ? '[REMARCAR] ' : '[?] ')\n  }\n}];"
      },
