      "id": "e18a80a3-e228-408a-8f76-50ff82ae33c8",
      "name": "Google Calendar — Eventos do dia seguinte",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1008,
        128
      ],
      "notes": "Requer credencial Google Calendar. Ajuste a janela no Edit Fields."
