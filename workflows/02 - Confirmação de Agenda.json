    {
      "parameters": {
        "jsCode": "const cfg = $('Edit Fields — Variáveis do Fluxo').first().json;\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const e = item.json;\n  const start = e.start?.dateTime || e.start?.date || '';\n  const end = e.end?.dateTime || e.end?.date || '';\n  const summary = e.summary || 'Compromisso';\n  const eventId = e.id || '';\n  const email =\n    e.attendees?.[0]?.email ||\n    e.extendedProperties?.private?.email ||\n    e.organizer?.email ||\n    '';\n  const cliente =\n    e.attendees?.[0]?.displayName ||\n    e.extendedProperties?.private?.nome ||\n    summary;\n  const telefone =\n    e.extendedProperties?.private?.telefone ||\n    '';\n\n  if (!eventId) continue;\n\n  const token = Buffer.from(`${eventId}:${cfg.token_secreto}`).toString('base64url');\n  const base = String(cfg.webhook_confirmacao_url || '').replace(/\\/$/, '');\n  const urlConfirma = `${base}?acao=confirma&eventId=${encodeURIComponent(eventId)}&token=${token}`;\n  const urlRemarca = `${base}?acao=remarca&eventId=${encodeURIComponent(eventId)}&token=${token}`;\n\n  const corpo =\n    `Olá ${cliente},\\n\\n` +\n    `Confirmamos seu horário em ${cfg.negocio_nome}?\\n\\n` +\n    `Evento: ${summary}\\n` +\n    `Início: ${start}\\n` +\n    `Fim: ${end}\\n\\n` +\n    `✅ Confirmar: ${urlConfirma}\\n` +\n    `📅 Remarcar: ${urlRemarca}\\n\\n` +\n    `${cfg.email_remetente_nome} — ${cfg.negocio_nome}`;\n\n  out.push({\n    json: {\n      ...cfg,\n      event_id: eventId,\n      event_summary: summary,\n      event_start: start,\n      event_end: end,\n      cliente_nome: cliente,\n      cliente_email: email,\n      cliente_telefone: telefone,\n      token_evento: token,\n      url_confirma: urlConfirma,\n      url_remarca: urlRemarca,\n      email_corpo_confirmacao: corpo,\n      email_corpo_lembrete_manha:\n        `Olá ${cliente},\\n\\nLembrete: seu horário é hoje.\\n\\n${summary}\\nInício: ${start}\\n\\nAté logo,\\n${cfg.email_remetente_nome} — ${cfg.negocio_nome}`,\n      status_agenda: cfg.status_pendente\n    }\n  });\n}\n\nreturn out.length ? out : [{ json: { ...cfg, sem_eventos: true } }];"
      },
